# ==============================================================================
# AIDA-ERP — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Never commit your real .env file or production secrets to source control.
# ==============================================================================

# --- REQUIRED: APPLICATION SECURITY ---
# Secret key used to sign application JWT session tokens.
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# --- APPLICATION & NETWORK SETTINGS ---
# Port exposed by the AIDA web application container
PORT=3001

# Allowed origins for CORS and CSRF protection (comma-separated if multiple)
ALLOWED_ORIGIN=http://localhost:3001

# PocketBase internal URL (used within Docker network)
PB_URL=http://pocketbase:8090

# --- POCKETBASE SUPERUSER (OPTIONAL) ---
# If left unset (default), the database starts without a superuser and the
# in-browser AIDA setup wizard will guide you through creating the superuser.
# If both are set, the database container provisions them on first boot.
# PB_ADMIN_EMAIL=admin@your-company.com
# PB_ADMIN_PASSWORD=your-strong-password-here

# --- INTEGRATION ENCRYPTION KEY (OPTIONAL) ---
# 64-character hexadecimal key (32 bytes) used to encrypt integration credentials.
# If left blank, the setup wizard generates and persists this key automatically.
# Generate with: openssl rand -hex 32
# AIDA_ENCRYPTION_KEY=

# --- PERSONAL / SOLO OPERATOR MODE (OPTIONAL) ---
# For solo operators, logging in with the email 'owner@local.aida' activates
# Personal Mode, streamlining the UI by hiding multi-user management.
# VITE_LOCAL_OWNER_PASSWORD=your-local-password
