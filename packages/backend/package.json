{
  "name": "@aida/backend",
  "version": "1.0.0",
  "private": true,
  "author": "Patrick Walton",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace=@aida/shared && tsx watch --env-file=.env src/index.ts",
    "start": "npm run build --workspace=@aida/shared && tsx --env-file=.env src/index.ts",
    "test": "node --import tsx --test test/authorize.test.ts",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "tsx src/scripts/import-legacy-sqlite.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pocketbase": "^0.26.2",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "zod": "^3.25.28",
    "@aida/shared": "*"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "tsx": "^4.19.4"
  }
}
